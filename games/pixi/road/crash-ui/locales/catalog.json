ils"},"x_c032ad":{"source":"X","en":"X","fr":"X","games":[],"group":"Difficulty & limits","ht":"X","usage":["text"],"previewWindow":"topbets","presets":["tabbed-shell-v1"]},"road_rules_document":{"source":"Guide the goat across the road one lane at a time. Every lane you clear raises the multiplier.\n\nPress **CASH OUT** at any lane to bank the current multiplier on your stake.\n\nSome lanes carry traffic. Step into one and the round ends with nothing.\n\nChoose Easy, Medium or Hard. Higher difficulty increases risk and reward. The risk meter shows the failure probability of the next step; in API mode it appears when the server supplies that probability.","en":"Guide the goat across the road one lane at a time. Every lane you clear raises the multiplier.\n\nPress **CASH OUT** at any lane to bank the current multiplier on your stake.\n\nSome lanes carry traffic. Step into one and the round ends with nothing.\n\nChoose Easy, Medium or Hard. Higher difficulty increases risk and reward. The risk meter shows the failure probability of the next step; in API mode it appears when the server supplies that probability.","fr":"Guidez la chèvre sur la route, une voie à la fois. Chaque voie franchie augmente le multiplicateur.\n\nAppuyez sur **CASH OUT** à n’importe quelle voie pour encaisser votre mise au multiplicateur actuel.\n\nDes véhicules circulent sur certaines voies. Si vous en heurtez un, la manche se termine sans gain.\n\nChoisissez Facile, Moyen ou Difficile. Une difficulté plus élevée augmente le risque et le gain. La jauge indique la probabilité d’échec du prochain pas ; en mode API, elle apparaît lorsque le serveur fournit cette probabilité.","ht":"Ede kabrit la travèse wout la yon liy alafwa. Chak liy ou travèse ogmante miltiplikatè a.\n\nPeze **CASH OUT** nan nenpòt liy pou pran gany miz ou a dapre miltiplikatè aktyèl la.\n\nGen liy kote machin ap pase. Si ou antre nan youn, tou a fini san ou pa genyen anyen.\n\nChwazi Fasil, Mwayen oswa Difisil. Plis nivo a difisil, se plis risk la ak rekonpans lan ogmante. Ba risk la montre pwobabilite pou pwochen pa a echwe; nan mòd API, li parèt lè sèvè a bay pwobabilite sa a.","label":"How to play · Content","format":"markdown","group":"Rules","games":["road"],"usage":["text"],"previewWindow":"rules"},"medium_d40496":{"source":"Medium","en":"Medium","fr":"Moyen","ht":"Mwayen","group":"Bet panel & messages","games":["road","plinko"],"usage":["text"]},"settings_menu_drawer":{"source":"Settings","en":"Settings","fr":"Réglages","ht":"Anviwònman","group":"Tabs & windows","games":[],"usage":["text","aria-labelledby"],"previewWindow":"menu","presets":["tabbed-shell-v1"],"usageByGame":{"road":["aria-labelledby"]}},"multiplier_b94c55":{"source":"MULTIPLIER","en":"MULTIPLIER","fr":"MULTIPLICATEUR","ht":"MILTIPLIKATÈ","group":"Bet panel & messages","games":[],"usage":["text"],"previewWindow":"betDetails","presets":["tabbed-shell-v1"]},"cashed_out_value_f0e320":{"source":"Cashed out · {value}×","en":"Cashed out · {value}×","fr":"Encaissé · {value}×","ht":"Lajan pran · {value}×","group":"Bet panel & messages","games":[],"usage":["text"],"presets":["tabbed-shell-v1"],"previewState":"win-transfer"},"not_enough_funds_631600":{"source":"Not enough funds","en":"Not enough funds","fr":"Fonds insuffisants","ht":"Pa gen ase lajan","group":"Bet panel & messages","games":["road","boom","hot_hands","plinko","mopyon_cascades","candy_cascade"],"usage":["text","aria-labelledby"],"previewWindow":"notice:funds","presets":["tabbed-shell-v1"]},"your_balance_is_too_low_ece4eb":{"source":"Your balance is too low for this bet. Top up to keep playing.","en":"Your balance is too low for this bet. Top up to keep playing.","fr":"Votre solde est trop bas pour cette mise. Rechargez pour continuer à jouer.","ht":"Balans ou twò ba pou miz sa a. Ajoute lajan pou kontinye jwe.","group":"Bet panel & messages","games":["road","boom","hot_hands","plinko","mopyon_cascades","candy_cascade"],"usage":["text"],"previewWindow":"notice:f